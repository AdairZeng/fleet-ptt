# 复制为 .env 后填写真实值。真实 .env 不得提交到仓库。

HTTP_ADDR=:8080
SQLITE_PATH=/data/fleet-ptt.db
SESSION_SECRET=change_me_to_a_long_random_string

# 七牛云（仅服务端签发 RTN RoomToken。真实值只放本地 .env，占位符无法进房）
QINIU_ACCESS_KEY=your_qiniu_access_key_here
QINIU_SECRET_KEY=your_qiniu_secret_key_here
QINIU_RTN_APP_ID=your_rtn_app_id_here

# 灵矽 Chat 回调校验。与灵矽请求头 Authorization: Bearer 的值一致。
# 留空时 POST /api/v1/linx/chat 一律拒绝。
LINX_CHAT_TOKEN=your_linx_callback_token_here

# 灵矽设备 WebSocket 桥接。配置 API Key 和智能体 ID 后，服务启动时自动完成 OTA、激活码绑定和 WebSocket 凭证获取。
LINX_API_KEY=your_linx_api_key_here
LINX_AGENT_ID=0d52f8540714321bbe2bed714f82ae2
LINX_API_BASE_URL=https://xrobo.qiniu.com
LINX_OTA_URL=https://xrobo.qiniuapi.com/v1/ota/
LINX_WS_URL=wss://xrobo-io.qiniuapi.com/v1/ws/
LINX_DEVICE_ID=02:46:50:50:54:01
# 自动绑定模式下不需要填写 LINX_DEVICE_TOKEN。
LINX_DEVICE_TOKEN=

# 灵矽可访问的本服务公网基址（含协议，无尾斜杠）。
# 回调地址为 ${PUBLIC_BASE_URL}/api/v1/linx/chat
PUBLIC_BASE_URL=https://your-public-host.example
